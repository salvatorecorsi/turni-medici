# Publish application sources and the custom theme only.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/LICENSE
!/CHANGELOG.md
!/dependencies.lock.json
!/wp-config.example.php
!/wp-cli.yml
!/scripts/
!/wp-content/

/wp-content/*
!/wp-content/plugins/
!/wp-content/themes/
/wp-content/plugins/*
!/wp-content/plugins/turnimedici-plugin/
!/wp-content/plugins/define-blocks/
!/wp-content/plugins/corsivo-core-editor/
/wp-content/themes/*
!/wp-content/themes/turnimedici-theme/

# Local configuration, credentials and development tools.
**/.*/
.env*
.npmrc
!/wp-content/plugins/define-blocks/editor/.npmrc
!/wp-content/plugins/corsivo-core-editor/configurator/.npmrc
.netrc
.htpasswd
wp-config.php
wp-config-local.php
auth.json
composer-auth.json
credentials*
secrets.*
access.txt
id_rsa*
id_ed25519*
*.pem
*.key
*.p12
*.pfx
*.keystore

# Runtime data, personal-data exports and backups.
uploads/
backups/
backup/
logs/
cache/
tmp/
temp/
_docs/
turnimedici-*.json
*.log
*.sql
*.sql.*
*.dump
*.db
*.db-*
*.sqlite*
*.bak
*.backup
*.old
*.orig
*.zip
*.7z
*.rar
*.tar
*.gz
*.csv
*.tsv
*.xls
*.xlsx
*.ods
*.pdf

# Reinstallable dependencies and editor/OS artifacts.
node_modules/
*.map
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
