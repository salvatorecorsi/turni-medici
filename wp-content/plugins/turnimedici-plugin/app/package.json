{
  "name": "turnimedici-app",
  "description": "Turni Medici demo application and Define Blocks custom fields",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "build": "npm run build:app && npm run build:custom-fields",
    "build:app": "wp-scripts build",
    "build:custom-fields": "webpack --config ../custom-fields/weekly-schedule/webpack.config.js --mode production",
    "start": "wp-scripts start",
    "start:custom-fields": "webpack --config ../custom-fields/weekly-schedule/webpack.config.js --mode development --watch"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@wordpress/icons": "^14.0.1"
  }
}
